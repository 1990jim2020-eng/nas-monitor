# ─────────────────────────────────────────────────────────────
# NAS Monitor 后端配置模板
# 复制为 .env 后按需填写。只填必填项即可跑起来；
# 未配置的可选服务会自动跳过，不会报错也不会显示空卡片。
# ─────────────────────────────────────────────────────────────

# ── 必填：访问令牌（客户端/网页端用它调用接口）──
# 建议用 `openssl rand -hex 24` 生成；App 首次启动时填入。
APP_API_TOKEN=CHANGE_ME_APP_TOKEN
# 网页端可单独用一个令牌（可留空，留空则只能用 APP_API_TOKEN）
WEB_API_TOKEN=

# ── 必填：本机地址 ──
# 本 NAS 的地址（Glances / Home Assistant / New API 等本地服务默认基于此主机）
NAS_HOST=CHANGE_ME_HOST
# NAS 在本机组网里的地址（仅用于概览的 latency 字段，可留空）
NAS_MESH_IP=
# 局域网主网段前缀，同 MAC 多 IP 时优先保留该网段（默认 192.168.）
LAN_PREFIX=192.168.

# ── 基础监控：Glances（推荐，必装）──
# 默认按 http://{NAS_HOST}:61208 访问；Glances 端口不同时在这里覆盖
NAS_GLANCES=

# ── 可选：Home Assistant（硬盘温度、风扇、UPS、卷容量文案）──
HA_URL=
HA_TOKEN=

# ── 可选：路由器（爱快 iKuai）──
# 留空则不采集路由器数据（WAN/在线设备/测速卡片自动隐藏）
ROUTER_HOST=
IKUAI_PASS=
ROUTER_SERVICE_URL=

# ── 可选：本机服务探活（留空则该项不探测）──
NAS_SERVICE_NEW_API=
NAS_SERVICE_KUMA=
NAS_SERVICE_HA=
NAS_SERVICE_GITEA=
NAS_SERVICE_MIHOMO=
NAS_SERVICE_SAFELINE=
NAS_SERVICE_LUCKY=
NAS_SERVICE_NARRATOAI=
NAS_SERVICE_SMANGA=
NAS_SERVICE_FAN_DASHBOARD=
NEW_API_KEY=

# ── 可选：远程主机（云服务器等，留空则概览不显示）──
ALIYUN_HOST=
ALIYUN_PUBLIC_IP=
ALIYUN_NAME=
ALIYUN_GLANCES=
ALIYUN_SECURITY_URL=
ALIYUN_SECURITY_TOKEN=
ALIYUN_SERVICE_NEW_API=
ALIYUN_SERVICE_GLANCES=
ALIYUN_SERVICE_MIHOMO=
ALIYUN_SERVICE_CORAZA=
TENCENT_HOST=
TENCENT_PUBLIC_IP=
TENCENT_NAME=
TENCENT_GLANCES=
TENCENT_SECURITY_URL=
TENCENT_SECURITY_TOKEN=

# ── 可选：上游 OpenWrt（二级路由 WAN 出口流量回填）──
OPENWRT_WAN3_HOST=
OPENWRT_WAN3_PORT=22
OPENWRT_WAN3_USER=root
OPENWRT_WAN3_PASSWORD=
OPENWRT_WAN3_IFACE=pppoe-wan

# ── 可选：AnythingLLM 知识库问答 ──
ANYTHINGLLM_URL=
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_WORKSPACE=

# ── 可选：网页端一次性登录码 ──
WEB_BOOTSTRAP_CODE=
WEB_BOOTSTRAP_EXPIRES_AT=0

# ── 可选：WAN 口测速（爱快 + macvlan）──
SPEEDTEST_BINARY_HOST=
SPEEDTEST_NETWORK=
SPEEDTEST_WAN1_IP=
SPEEDTEST_WAN2_IP=
SPEEDTEST_WAN3_IP=

# ── 可选：WorkBuddy 账号池（网关页账号卡片 + 积分）──
# *_CONFIG_FILE / *_STATE_DIR 为历史部署说明字段，基础 Compose 不消费。
# WORKBUDDY_CONFIG / *_AUTH_DIR / WORKBUDDY_STATE_FILE 才是采集器读取的容器内路径。
# 按自己的环境添加最小只读挂载，再填入容器内目的路径，不能直接填宿主路径。
WORKBUDDY_BASE=
WORKBUDDY_WAN1_BASE=
WORKBUDDY_CONFIG_FILE=
WORKBUDDY_WAN1_CONFIG_FILE=
WORKBUDDY_AUTH_DIR=
WORKBUDDY_WAN1_AUTH_DIR=
WORKBUDDY_STATE_DIR=

PIPIO_BASE_URL=
PIPIO_USER_ID=
PIPIO2_USER_ID=
PIPIO_ACCOUNT_NAME=
PIPIO2_ACCOUNT_NAME=
PIPIO_UPTIME_URL=
PIPIO_WATCH_PREFIX=
PIPIO_WATCH_MODELS=
PIPIO_SECRET_DIR=/run/secrets
NAS_MONITOR_SCHEDULER=0
NEW_API_URL=
NEWAPI_ADMIN_TOKEN_FILE=/run/secrets/newapi-admin-token.txt
MONITOR_BIND_ADDRESS=127.0.0.1
MONITOR_PORT=8765
WORKBUDDY_CONFIG=/run/secrets/workbuddy-config.json
WORKBUDDY_WAN1_CONFIG=/run/secrets/workbuddy-wan1-config.json
DOCKER_GID=
HA_CABINET_TEMPERATURE_ENTITY=
HA_CABINET_HUMIDITY_ENTITY=
HA_CABINET_POWER_ENTITY=
